        "foregroundImage": "./coat-of-arms-transparent.png",
        "backgroundColor": "#06291A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "extra": {
      "eas": {
