rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'inspector'];
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.citizenId == request.auth.uid
        && request.resource.data.status in ['Draft', 'Submitted']
        && !request.resource.data.keys().hasAny([
          'reviewedBy',
          'reviewedAt',
          'reviewNote'
        ]);
      allow read: if isStaff()
        || (signedIn() && resource.data.citizenId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.citizenId == request.auth.uid
          && request.resource.data.citizenId == resource.data.citizenId
          && resource.data.status == 'Draft'
          && request.resource.data.status in ['Draft', 'Submitted']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'category',
            'description',
            'latitude',
            'longitude',
            'locationName',
            'evidenceUrl',
            'status',
            'updatedAt'
          ]))
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'inspector'
          && request.auth.token.email == resource.data.assignedInspector
          && request.resource.data.status in ['Under Review', 'Verified', 'Assigned']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'reviewedBy',
            'reviewedAt',
            'reviewNote',
            'investigationObservation',
            'investigationSeverity',
            'investigationAction',
            'investigationEvidenceUrl',
            'investigationSubmittedBy',
            'investigationSubmittedAt'
          ]));
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (signedIn() && request.auth.token.email == resource.data.email);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'citizen';
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
    }
  }
}
